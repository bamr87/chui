# bamr87/chui — ~/.zshrc (symlinked from this repo)
# Instant prompt must stay at the top.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="powerlevel10k/powerlevel10k"

plugins=(
  git
  docker
  vscode
  web-search
  colored-man-pages
  jsontools
  copypath
  brew
  macos
  fzf-tab
  zsh-autosuggestions
  zsh-syntax-highlighting
)

source "$ZSH/oh-my-zsh.sh"

CHUI_ZSHRC="${${(%):-%x}:A}"
export CHUI_ROOT="${CHUI_ROOT:-${CHUI_ZSHRC:h:h}}"

export PATH="$HOME/.local/bin:$PATH"
export PATH="$HOME/.opencode/bin:$PATH"
export EDITOR="${EDITOR:-code --wait}"

[[ -f "$CHUI_ROOT/config/aliases.zsh" ]] && source "$CHUI_ROOT/config/aliases.zsh"
[[ -f "$CHUI_ROOT/config/functions.zsh" ]] && source "$CHUI_ROOT/config/functions.zsh"

command -v zoxide >/dev/null && eval "$(zoxide init zsh)"
if command -v fzf >/dev/null && [[ -o zle ]]; then
  source <(fzf --zsh)
fi

[[ -f "${ZDOTDIR:-$HOME}/.p10k.zsh" ]] && source "${ZDOTDIR:-$HOME}/.p10k.zsh"

if [[ -o interactive && -z "${CHUI_NO_FETCH:-}" && -z "${ZELLIJ:-}" ]] && command -v fastfetch >/dev/null; then
  fastfetch --logo-type small --structure title:os:host:kernel:uptime:memory:shell
fi
